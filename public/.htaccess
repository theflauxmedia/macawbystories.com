<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the request is an actual file or directory, serve it normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, route everything through the SPA entrypoint
  RewriteRule ^ index.html [L]
</IfModule>

